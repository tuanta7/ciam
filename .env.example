GOOSE_DRIVER=postgres
GOOSE_DBSTRING=postgresql://postgres:password@localhost:5432/ciam
GOOSE_MIGRATION_DIR=/data/migrations
GOOSE_TABLE=migrations

POSTGRES_DSN=postgresql://postgres:password@localhost:5432/ciam

ISSUER=http://localhost:13702
CRYPTO_KEY=change-me-authorization-code-encryption-key

# Built-in login page; leave unset to disable it and use your own login UI.
DEV_LOGIN_EMAIL=dev@example.com
DEV_LOGIN_PASSWORD=password
